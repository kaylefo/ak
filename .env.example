# Application
APP_ENV=development
APP_BASE_URL=http://localhost:3000
PUBLIC_APP_NAME=Tsubo
NEXT_PUBLIC_API_URL=http://localhost:8000

# Database
DATABASE_URL=postgresql+asyncpg://tsubo:tsubo@localhost:5432/tsubo
DATABASE_URL_SYNC=postgresql://tsubo:tsubo@localhost:5432/tsubo

# Redis
REDIS_URL=redis://localhost:6379/0

# OpenSearch
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=tsubo-raw
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# Temporal
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

# Auth
AUTH_SECRET=change-me-in-production-use-32-chars-min
ADMIN_BOOTSTRAP_EMAIL=admin@tsubo.local

# Email (Mailpit locally)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=noreply@tsubo.local

# Optional enrichment
MLIT_REINFOLIB_API_KEY=
TRANSLATION_PROVIDER=
TRANSLATION_API_KEY=

# Observability
ERROR_REPORTING_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Maps
MAP_TILE_CONFIGURATION={"style":"https://tile.openstreetmap.org/{z}/{x}/{y}.png","attribution":"© OpenStreetMap contributors"}

# FX providers
FX_FAWAZ_PRIMARY_URL=https://cdn.jsdelivr.net/npm/@fawazahmed0/currency-api@latest/v1/currencies
FX_FAWAZ_FALLBACK_URL=https://latest.currency-api.pages.dev/v1/currencies
FX_FRANKFURTER_URL=https://api.frankfurter.dev
FX_CACHE_TTL_SECONDS=3600
